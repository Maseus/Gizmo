index 6334f3cca..fbd5f28d8 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -3910,6 +3910,87 @@ llama_memory_t llama_get_memory(const struct llama_context * ctx) {
     return ctx->get_memory();
 }
 
+llama_memory_context_ptr llama_context::kv_cache_init_for_batch(int32_t n_tokens) {
+    if (n_tokens <= 0) {
+        return nullptr;
+    }
+    if (!memory) {
+        LLAMA_LOG_ERROR("%s: context has no KV cache memory\n", __func__);
+        return nullptr;
+    }
+
+    const auto & vocab   = model.vocab;
+    const auto & hparams = model.hparams;
+    const int64_t n_embd = hparams.n_embd_inp();
+
+    const uint32_t n_seq_max = cparams.kv_unified ? LLAMA_MAX_SEQ : cparams.n_seq_max;
+
+    // Build a minimal batch with token=0 (placeholder; init_batch
+    // only cares about slot allocation, not actual token values).
+    // Positions 0..n_tokens-1 cover the prefill range.
+    llama_batch batch = llama_batch_init(n_tokens, /*embd=*/0, n_seq_max);
+    if (!batch.token) {
+        LLAMA_LOG_ERROR("%s: llama_batch_init failed\n", __func__);
+        return nullptr;
+    }
+    batch.n_tokens = n_tokens;
+    for (int32_t i = 0; i < n_tokens; ++i) {
+        batch.token[i]     = 0;        // placeholder
+        batch.pos[i]       = (llama_pos) i;
+        batch.n_seq_id[i]  = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i]    = 1;        // every token wants logits
+    }
+
+    if (!balloc->init(batch, vocab, memory.get(), n_embd, n_seq_max, /*output_all=*/false)) {
+        LLAMA_LOG_ERROR("%s: failed to initialize batch\n", __func__);
+        llama_batch_free(batch);
+        return nullptr;
+    }
+
+    // Reserve the output buffer so llama_get_logits returns a valid
+    // pointer. The full decode() does this in its pre-flight; without
+    // it, logits.data is nullptr and llama_sampler_sample crashes.
+    const uint32_t n_outputs_all = balloc->get_n_outputs();
+    if (output_reserve((int32_t)n_outputs_all) < n_outputs_all) {
+        LLAMA_LOG_ERROR("%s: could not reserve output buffer for %d outputs\n",
+                __func__, (int)n_outputs_all);
+        llama_batch_free(batch);
+        return nullptr;
+    }
+
+    llama_memory_context_ptr mctx =
+        memory->init_batch(*balloc, cparams.n_ubatch, /*output_all=*/false);
+    if (!mctx) {
+        LLAMA_LOG_ERROR("%s: memory->init_batch returned null\n", __func__);
+        llama_batch_free(batch);
+        return nullptr;
+    }
+
+    // Map output row 0 to the last token's batch index so that
+    // llama_sampler_sample(ctx, idx=-1) -> get_logits_ith(-1)
+    // returns the sharded prefill's last-token logits (the engine
+    // copies them into logits.data[0]).
+    n_outputs = 1;
+    output_ids[n_tokens - 1] = 0;
+
+    llama_batch_free(batch);
+    return mctx;
+}
+
+llama_memory_context_t llama_kv_cache_init_for_batch(
+        struct llama_context * ctx,
+                   int32_t      n_tokens) {
+    if (!ctx) {
+        return nullptr;
+    }
+    return ctx->kv_cache_init_for_batch(n_tokens).release();
+}
+
+void llama_memory_context_free(llama_memory_context_t mctx) {
+    delete mctx;
+}
